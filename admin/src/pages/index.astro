---
import '../styles/global.css';
import { themeBootstrap } from '@robyrew/web-config/theme-bootstrap';

// One static page with four views; src/admin.ts picks one after asking /admin/api/me.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>Accounts · Now playing</title>
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f2f2f2" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0c0e" />
    <link rel="icon" href="/admin/favicon.svg" type="image/svg+xml" />
    <script is:inline set:html={themeBootstrap} />
  </head>
  <body class="min-h-dvh bg-ground text-ink antialiased">
    <header class="sticky top-0 z-50 px-4 pt-3">
      <!-- The one floating element, so the one made of glass; content below is opaque. -->
      <div class="rw-glass mx-auto flex w-full max-w-2xl items-center justify-between gap-3 rounded-full px-4 py-2">
        <span class="flex min-w-0 items-center gap-2 text-[15px] font-semibold tracking-tight text-g-ink">
          <img src="/admin/favicon.svg" alt="" class="size-7" />
          <span class="truncate">Now playing</span>
        </span>
        <form method="post" action="/admin/logout" data-signed-in hidden>
          <button type="submit" class="rw-btn rw-btn--plain rw-btn--sm">Sign out <span class="sr-only" data-me></span></button>
        </form>
      </div>
    </header>

    <main class="mx-auto w-full max-w-2xl px-4 pb-16 pt-8">
      <section data-view="loading" class="rw-card flex items-center gap-3 p-6" aria-live="polite">
        <span class="rw-spinner" aria-hidden="true"></span>
        <span class="text-ink-2">Loading…</span>
      </section>

      <section data-view="signin" class="rw-card p-6 sm:p-8" hidden>
        <h1 class="text-2xl font-semibold tracking-tight">Spotify accounts for the record player</h1>
        <p class="mt-3 text-ink-2">
          The accounts whose music shows on the GitHub profile. Sign in with your RobyRew ID to add or change them.
        </p>
        <p class="rw-hint rw-hint--error mt-4" role="alert" data-signin-problem hidden></p>
        <div class="rw-actions mt-6">
          <a class="rw-btn rw-btn--primary rw-btn--lg" href="/admin/login">Sign in</a>
        </div>
      </section>

      <section data-view="off" class="rw-card p-6" hidden>
        <h1 class="text-xl font-semibold">Admin is switched off</h1>
        <p class="mt-2 text-ink-2">
          The service has no Logto app configured (LOGTO_APP_ID, LOGTO_APP_SECRET, ADMIN_SUBS). The record player's
          API keeps working.
        </p>
      </section>

      <div data-view="admin" class="flex flex-col gap-5" hidden>
        <section class="rw-card p-5" aria-labelledby="deck-title">
          <h2 id="deck-title" class="text-sm font-semibold uppercase tracking-wide text-ink-3">On the deck</h2>
          <div class="mt-3 flex items-center gap-4">
            <img data-deck-cover alt="" class="size-16 shrink-0 rounded-lg bg-panel object-cover" hidden />
            <div class="min-w-0">
              <p class="font-mono text-xs uppercase tracking-wider text-ink-3" data-deck-status>—</p>
              <p class="truncate text-lg font-semibold" data-deck-title></p>
              <p class="truncate text-ink-2" data-deck-sub></p>
            </div>
          </div>
          <p class="mt-3 text-sm text-ink-3" data-deck-live></p>
        </section>

        <section aria-labelledby="accounts-title">
          <div class="flex items-baseline justify-between gap-3">
            <h2 id="accounts-title" class="text-lg font-semibold">Accounts</h2>
            <p class="text-sm text-ink-3">First one playing wins, in this order.</p>
          </div>
          <ol class="mt-3 flex flex-col gap-3" data-accounts></ol>
        </section>

        <section class="rw-card p-5" aria-labelledby="howto-title">
          <h2 id="howto-title" class="text-lg font-semibold">Getting an account's sp_dc</h2>
          <ol class="mt-3 list-decimal space-y-2 pl-5 text-ink-2">
            <li>Open a private window and log in to that account at <span class="font-mono text-ink">open.spotify.com</span>.</li>
            <li>
              Open the developer tools and find the site's cookies (Chrome: Application → Cookies; Firefox: Storage →
              Cookies; Safari: Storage → Cookies). Copy the value of <span class="font-mono text-ink">sp_dc</span>.
            </li>
            <li>
              Paste it into the account's slot. Then close the private window <strong>without logging out</strong>:
              logging out ends that session.
            </li>
          </ol>
          <p class="mt-3 text-sm text-ink-3">
            Spotify is asked whose session it is before it is saved. It is stored encrypted and never shown again.
          </p>
        </section>
      </div>
    </main>

    <template id="account-row">
      <li class="rw-card p-4">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="text-xs font-medium uppercase tracking-wide text-ink-3">Account <span data-slot></span></p>
            <p class="truncate font-semibold" data-name></p>
            <p class="truncate text-sm text-ink-2" data-last></p>
          </div>
          <span class="rw-badge shrink-0" data-status></span>
        </div>
        <details class="mt-3" data-edit>
          <summary class="cursor-pointer text-sm text-accent" data-summary></summary>
          <div class="mt-3 flex flex-col gap-4">
            <form class="flex flex-col gap-2" data-rename>
              <label class="rw-label">Name on the deck</label>
              <div class="flex gap-2">
                <input class="rw-field rw-field--grow" name="label" maxlength="40" autocomplete="off" placeholder="Their Spotify username" />
                <button class="rw-btn rw-btn--sm" type="submit">Save</button>
              </div>
            </form>
            <form class="flex flex-col gap-2" data-session>
              <label class="rw-label">sp_dc</label>
              <input class="rw-field font-mono" name="sp_dc" type="password" autocomplete="off" spellcheck="false" autocapitalize="none" required />
              <p class="rw-hint" aria-live="polite" data-session-status></p>
              <div class="rw-actions">
                <button class="rw-btn rw-btn--primary rw-btn--sm" type="submit">Check and save</button>
              </div>
            </form>
            <div class="rw-actions" data-remove-wrap>
              <button class="rw-btn rw-btn--danger rw-btn--sm" type="button" data-remove>Remove account</button>
            </div>
          </div>
        </details>
      </li>
    </template>

    <script>
      import '../admin.ts';
    </script>
  </body>
</html>
